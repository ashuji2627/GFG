class Solution {
  public:
    vector<int> update(int n, vector<int>& updates) {
        // code here
        vector<int> ans(n, 0);
                int m = updates.size();

                for(int i=0; i<m; i++) {
                    int idx = updates[i];

                    ans[idx-1] += 1;
                }

                // calculate prefixSum
                for(int i=1; i<n; i++) {
                    ans[i] += ans[i-1];
                }
                return ans;
    }
};
